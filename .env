# AI Operations Copilot - Development .env
# Generated by Grok for local Docker deployment

# General
APP_NAME=AI Operations Copilot
ENV=development

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/copilot

# Redis
REDIS_URL=redis://redis:6379/0

# Qdrant
QDRANT_URL=http://qdrant:6333

# Celery
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# Security (CHANGE IN PRODUCTION!)
SECRET_KEY=supersecretkeyforlocaldev1234567890
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_MINUTES=10080

# WhatsApp integration (use real tokens for production webhook)
WHATSAPP_VERIFY_TOKEN=wh_verify_token_local
WHATSAPP_ACCESS_TOKEN=wh_access_token_local

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:18000

# Optional: For local non-docker testing
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/copilot
